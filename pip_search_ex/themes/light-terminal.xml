<theme name="light-terminal">
  <aliases>
    <alias>--theme-light-terminal</alias>
    <alias>--light-terminal</alias>
    <alias>--lterm</alias>
    <alias>--inverse</alias>
  </aliases>

  <colors>
    <installed>#008000</installed>
    <outdated>#cc5200</outdated>
    <not_installed>#666666</not_installed>
    <error>#cc0000</error>
    <header>#0066cc</header>
    <border>#888888</border>
    <default>#000000</default>
  </colors>
</theme>
